# Copy to .env (gitignored) in the repo root. Never commit real keys.
# All `make` targets load it automatically (worktrees fall back to the main checkout's .env).
ANTHROPIC_API_KEY=
# live | cache | offline   (offline never touches the network; tests force offline)
LLM_MODE=cache
STORMCHECK_MODE=cache
# Spend cap for live Claude calls, in USD
LLM_CAP_USD=30
# Who you are for scripts/land.sh and the pre-commit owner check: david | filip | justin
STORMCHECK_OWNER=
